{
  "name": "reservation-watch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/shared"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm run dev -w @reservation-watch/api\" \"npm run dev -w @reservation-watch/web\"",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test -w @reservation-watch/api",
    "build": "npm run build -w @reservation-watch/shared && npm run build -w @reservation-watch/web && npm run build -w @reservation-watch/api",
    "start": "node --env-file-if-exists=.env apps/api/dist/server.js",
    "test:production": "node scripts/smoke-production.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
